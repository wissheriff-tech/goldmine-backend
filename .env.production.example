# ============================================
# SalonMoney Backend - Production Environment
# Vercel + Railway Deployment Configuration
# ============================================
#
# INSTRUCTIONS:
# Copy these variables to Vercel's Environment Variables section
# Update all values marked with YOUR_* placeholders
# ============================================

# ============================================
# Node Environment (REQUIRED)
# ============================================
NODE_ENV=production

# ============================================
# Server Configuration (REQUIRED)
# ============================================
PORT=5000

# ============================================
# Database Configuration (REQUIRED)
# Railway MySQL Database
# ============================================
# Your Railway MySQL connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:CdcnQNLfAuXzpZEiaBeNjAbRuECldnQU@yamanote.proxy.rlwy.net:41765/railway

# ============================================
# JWT Configuration (REQUIRED - CHANGE THESE!)
# ============================================
# Generate new secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_GENERATED_JWT_SECRET_HERE_CHANGE_THIS_MUST_BE_AT_LEAST_128_CHARACTERS_LONG_FOR_SECURITY
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=YOUR_GENERATED_REFRESH_TOKEN_SECRET_HERE_CHANGE_THIS_MUST_BE_DIFFERENT_FROM_JWT_SECRET
REFRESH_TOKEN_EXPIRE=7d

# ============================================
# Frontend URL (REQUIRED)
# ============================================
# IMPORTANT: Set this to your deployed frontend URL on Vercel
# Example: https://salonmoney.vercel.app
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN_HERE

# ============================================
# Binance API Configuration (OPTIONAL)
# ============================================
# Get API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false

# ============================================
# Conversion Rates (REQUIRED)
# ============================================
NSL_TO_USDT_RECHARGE=23
USDT_TO_NSL_WITHDRAWAL=23

# ============================================
# Fee Settings (REQUIRED)
# ============================================
RECHARGE_FEE_PERCENTAGE=10
WITHDRAWAL_FEE_PERCENTAGE=10
MIN_WITHDRAWAL_AMOUNT_NSL=100

# ============================================
# Referral Settings (REQUIRED)
# ============================================
REFERRAL_BONUS_PERCENTAGE=35
MAX_REFERRAL_LEVEL=1

# ============================================
# Super Admin Credentials
# ============================================
# NOTE: Super Admin is created via database init script
# Username: Wisradom
# Password: Norman@1995?.
SUPER_ADMIN_USERNAME=Wisradom
SUPER_ADMIN_EMAIL=superadmin@salonmoney.com
SUPER_ADMIN_PHONE=+1000000000

# ============================================
# Email Configuration (REQUIRED for emails)
# ============================================
# For Gmail: https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=YOUR_GMAIL_ADDRESS@gmail.com
EMAIL_PASSWORD=YOUR_APP_SPECIFIC_PASSWORD
EMAIL_FROM=noreply@salonmoney.com

# ============================================
# Twilio SMS Configuration (OPTIONAL)
# ============================================
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
