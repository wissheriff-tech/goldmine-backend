# Server Configuration
NODE_ENV=production
PORT=5000

# Railway MySQL Database
DATABASE_URL=mysql://root:CdcnQNLfAuXzpZEiaBeNjAbRuECldnQU@yamanote.proxy.rlwy.net:41765/railway

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-128-characters-long-for-production-security-replace-this-with-a-real-secret-key-generated-randomly
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret-key-minimum-128-characters-long-for-production-security-replace-this-with-a-different-real-secret-key
REFRESH_TOKEN_EXPIRE=7d

# Currency Conversion Rates
NSL_TO_USDT_RECHARGE=23
USDT_TO_NSL_WITHDRAWAL=23
RECHARGE_FEE_PERCENTAGE=10
WITHDRAWAL_FEE_PERCENTAGE=10
MIN_WITHDRAWAL_AMOUNT_NSL=100

# Referral Settings
REFERRAL_BONUS_PERCENTAGE=35
MAX_REFERRAL_LEVEL=1

# Super Admin (Already created via init script)
# Username: Wisradom
# Password: Norman@1995?.
SUPER_ADMIN_USERNAME=Wisradom
SUPER_ADMIN_EMAIL=superadmin@salonmoney.com
SUPER_ADMIN_PHONE=+1000000000

# Email Configuration (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@salonmoney.com

# Frontend URL (Update after deploying frontend to Vercel)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Binance API (Optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=
