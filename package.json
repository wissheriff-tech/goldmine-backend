{
  "name": "goldmine-backend",
  "version": "1.0.0",
  "description": "Gold Mine - Secure Salon Financial Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:unit": "cross-env NODE_ENV=test jest __tests__/models",
    "test:integration": "cross-env NODE_ENV=test jest --passWithNoTests __tests__/integration",
    "seed:admin": "node scripts/admin/createSuperAdmin.js",
    "sync:usdt-balances": "node scripts/admin/syncUsdtBalances.js",
    "seed:products": "node scripts/seed/seedProducts.js"
  },
  "keywords": [
    "salon",
    "finance",
    "investment"
  ],
  "author": "Gold Mine Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.22.5",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "undici": "6.27.0",
    "uuid": "^11.1.1"
  }
}
